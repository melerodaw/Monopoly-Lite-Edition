+.label-casilla  { -fx-font-size: 13px; }
 .label-dado     { -fx-font-size: 28px; }
 .label-accion   { -fx-font-size: 12px; -fx-wrap-text: true; }
+.boton-accion   { -fx-background-color: #007bff; -fx-text-fill: white; }
 .boton-comprar  { -fx-background-color: #28a745; -fx-text-fill: white; }
 .boton-turno    { -fx-background-color: #007bff; -fx-text-fill: white; }
 
+/* Panel de información (BOTTOM) */
+.panel-info { -fx-background-color: #f8f9fa;
+              -fx-border-color: #dee2e6;
+              -fx-border-width: 1 0 0 0; }
+
 /* Tokens de jugadores (círculos de colores) */
